<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\YeniRPA.Web\YeniRPA.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The marketplace exports TitleCleanerRealFileTests runs against. They used to sit in the web
         project's wwwroot and reached the test output through its content glob — which also meant
         real seller data was served, unauthenticated, from the running app: GET /laptop-test.xlsx
         handed the whole file to anyone. They live here now, next to the only code that reads them,
         and the server has no route to them at all.

         Still covered by the root .gitignore's "*.xlsx", so they stay out of the repository: a fresh
         clone has no sample data and the real-file tests will fail their File.Exists guard rather
         than pass emptily. -->
    <None Include="samples\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>