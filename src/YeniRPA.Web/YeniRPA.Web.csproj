<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>YeniRPA.Web</RootNamespace>
    <AssemblyName>YeniRPA.Web</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <!-- Drives the Mirakl back office for the Create Return automation module. -->
    <PackageReference Include="Microsoft.Playwright" Version="1.58.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The file readers and the order-number key are internal; the tests cover them directly
         because that is where the report's join actually lives. -->
    <InternalsVisibleTo Include="YeniRPA.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Web SDK serves static files straight from the source tree in Debug and never refreshes
         $(OutDir)wwwroot. Run the built exe directly, though, and *that* folder is the content root:
         a copy left there by an old publish then gets served instead, silently handing out an
         interface months out of step with the code. Keeping it in sync costs a file copy and closes
         a trap that otherwise only shows up as "my change did nothing". -->
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
