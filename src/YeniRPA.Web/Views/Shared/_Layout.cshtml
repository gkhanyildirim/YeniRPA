<!DOCTYPE html>
<html lang="en" data-theme="">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] &middot; Marketplace Reporting</title>
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="~/images/favicon-48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/favicon-180.png" />
    <link rel="preload" href="~/lib/fonts/ibm-plex-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @*
        Applied before first paint so nobody sees a white flash.
        Kept inline and tiny on purpose — it must run before the stylesheet resolves.

        Dark is the default: this is a monitoring console that is read for long stretches, and the
        design is built around the dark surface. A saved choice always wins, in both directions.
    *@
    <script>
        (function () {
            var t = null;
            try { t = localStorage.getItem('rpa-theme'); } catch (e) { /* private mode */ }
            document.documentElement.dataset.theme = (t === 'light' || t === 'dark') ? t : 'dark';
        })();
    </script>
</head>
<body>
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
