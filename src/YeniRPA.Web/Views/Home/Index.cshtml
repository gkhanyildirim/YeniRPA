                    </div>
                    <div class="field">
                        <label for="inc-lifecycle">Lifecycle</label>
                        <select id="inc-lifecycle"></select>
                    </div>
                    <div class="field">
                        <label for="inc-status">Status</label>
                        <select id="inc-status"></select>
                    </div>
                    <div class="field">
                        <label for="inc-reason">Reason</label>
                        <select id="inc-reason"></select>
                    </div>
