            <div class="results" id="mr-run" hidden>
                <div class="section-title">Run log</div>
                <div class="card">
                    <div class="run-head">
                        <span>Orders processed</span>
                        <span class="mono" id="mr-progress-text">0 / 0</span>
                    </div>
                    <div class="progress" id="mr-progress" role="progressbar"
                         aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"
                         aria-label="Mark as Received progress">
                        <span class="progress-fill" id="mr-progress-fill"></span>
                    </div>
                    <pre class="console" id="mr-console"></pre>
                </div>
                <p class="note">
                    An order that fails is screenshotted to <code>artifacts/mark-received</code> beside the
                    executable and the run moves on to the next one.
                </p>
            </div>

            <footer class="page-foot">Marketplace Reporting &middot; Mark as Received</footer>
        </section>

