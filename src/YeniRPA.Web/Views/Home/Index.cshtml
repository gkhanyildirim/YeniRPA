@model YeniRPA.Web.Models.MethodologyViewModel
@{
    ViewData["Title"] = "Reports";
}

@*
    One glyph per module, drawn inline so the app keeps its no-external-requests property. The
    rail and the panel header draw the same path from this one table, so a module cannot end up
    wearing two different marks.
*@
@{
    var iconPaths = new Dictionary<string, string>
    {
        ["order-report"]   = "<path d='M3 3v16a2 2 0 0 0 2 2h16'/><rect x='7' y='11' width='3.2' height='6' rx='1'/><rect x='14' y='6' width='3.2' height='11' rx='1'/>",
        ["return-sla"]     = "<circle cx='12' cy='12' r='9'/><path d='M12 7v5l3.5 2'/>",
        ["incidents"]      = "<path d='M10.3 3.7 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.7a2 2 0 0 0-3.4 0z'/><path d='M12 9.5v4'/><path d='M12 17h.01'/>",
        ["ticket-seller"]  = "<path d='M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2.5 2.5 0 0 0 0 6v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2.5 2.5 0 0 0 0-6z'/><path d='M14 8v8'/>",
        ["title-cleaner"]  = "<path d='m5 19 9-9'/><path d='m14.5 4.5 5 5-3 3-5-5z'/><path d='M6 4v3M4.5 5.5h3M18 15v2.5M16.8 16.2h2.4'/>",
        ["create-return"]  = "<path d='M3 12a9 9 0 1 0 2.6-6.4'/><path d='M3 4v5h5'/>",
        ["mark-received"]  = "<circle cx='12' cy='12' r='9'/><path d='m8.5 12.2 2.4 2.4 4.6-4.9'/>",
        ["product-status"] = "<path d='M21 8 12 3 3 8v8l9 5 9-5z'/><path d='m3 8 9 5 9-5M12 13v8'/>",
        ["late-orders"]    = "<path d='M3 7h10v9H3z'/><path d='M13 10h4l4 3.5V16h-8z'/><circle cx='7' cy='18' r='1.8'/><circle cx='17' cy='18' r='1.8'/>",
        ["offer-warnings"] = "<path d='M20.6 13.4 13 21a1.9 1.9 0 0 1-2.7 0l-7-7a1.9 1.9 0 0 1-.5-1.3V4.8c0-1 .8-1.8 1.8-1.8h7.9c.5 0 1 .2 1.3.5l6.8 6.8a1.9 1.9 0 0 1 0 2.7z'/><circle cx='7.8' cy='7.8' r='1.3'/>",
        ["vat-warnings"]   = "<path d='M6 2h12v20l-3-2-3 2-3-2-3 2z'/><path d='m9.5 14.5 5-5'/><circle cx='9.6' cy='9.6' r='1'/><circle cx='14.4' cy='14.4' r='1'/>",
        ["methodology"]    = "<path d='M4 5.5A2.5 2.5 0 0 1 6.5 3H20v14H6.5A2.5 2.5 0 0 0 4 19.5z'/><path d='M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5'/>"
    };

    Func<string, string, Microsoft.AspNetCore.Html.IHtmlContent> Icon = (cls, key) =>
        new Microsoft.AspNetCore.Html.HtmlString(
            "<span class=\"" + cls + "\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" " +
            "stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" " +
            "stroke-linejoin=\"round\">" + iconPaths[key] + "</svg></span>");

    Func<string, Microsoft.AspNetCore.Html.IHtmlContent> NavIcon = key => Icon("nav-icon", key);
    Func<string, Microsoft.AspNetCore.Html.IHtmlContent> PageIcon = key => Icon("page-icon", key);
}

<div class="shell" id="shell">

    @* .rail paints the full column height; .rail-inner is what actually sticks. *@
    <aside class="rail" id="rail">
      <div class="rail-inner">
        <div class="brand">
            <img class="brand-mark" src="~/images/brand-mark.png" alt="MediaMarkt Saturn" />
            <div class="brand-text">
                <div class="brand-title">Marketplace Reporting</div>
                <div class="brand-sub">Mirakl&nbsp;Ops</div>
            </div>
        </div>

        <nav class="nav" role="tablist" aria-label="Reports">
            <div class="nav-label">Reports</div>

            <button type="button" class="nav-item" role="tab" id="tab-order"
                    aria-controls="panel-order" aria-selected="true" data-module="order-report">
                @NavIcon("order-report")
                <span class="nav-text">Order Report</span>
            </button>

            <button type="button" class="nav-item" role="tab" id="tab-return"
                    aria-controls="panel-return" aria-selected="false" data-module="return-sla" tabindex="-1">
                @NavIcon("return-sla")
                <span class="nav-text">Return SLA Report</span>
            </button>

            <button type="button" class="nav-item" role="tab" id="tab-incidents"
                    aria-controls="panel-incidents" aria-selected="false" data-module="incidents" tabindex="-1">
                @NavIcon("incidents")
                <span class="nav-text">Incidents Report</span>
            </button>

            <button type="button" class="nav-item" role="tab" id="tab-ticket-seller"
                    aria-controls="panel-ticket-seller" aria-selected="false" data-module="ticket-seller" tabindex="-1">
                @NavIcon("ticket-seller")
                <span class="nav-text">Ticket &rarr; Seller</span>
            </button>

            <button type="button" class="nav-item" role="tab" id="tab-title-cleaner"
                    aria-controls="panel-title-cleaner" aria-selected="false" data-module="title-cleaner" tabindex="-1">
                @NavIcon("title-cleaner")
                <span class="nav-text">Title Cleaner</span>
            </button>

            <div class="nav-label">Automation</div>

            <button type="button" class="nav-item" role="tab" id="tab-create-return"
                    aria-controls="panel-create-return" aria-selected="false" data-module="create-return" tabindex="-1">
                @NavIcon("create-return")
                <span class="nav-text">Create Return</span>
            </button>

            <button type="button" class="nav-item" role="tab" id="tab-mark-received"
                    aria-controls="panel-mark-received" aria-selected="false" data-module="mark-received" tabindex="-1">
                @NavIcon("mark-received")
                <span class="nav-text">Mark as Received</span>
            </button>

            <button type="button" class="nav-item" role="tab" id="tab-product-status"
                    aria-controls="panel-product-status" aria-selected="false" data-module="product-status" tabindex="-1">
                @NavIcon("product-status")
                <span class="nav-text">Product Status</span>
            </button>

            <button type="button" class="nav-item" role="tab" id="tab-late-orders"
                    aria-controls="panel-late-orders" aria-selected="false" data-module="late-orders" tabindex="-1">
                @NavIcon("late-orders")
                <span class="nav-text">Late Order Warnings</span>
            </button>

            <button type="button" class="nav-item" role="tab" id="tab-offer-warnings"
                    aria-controls="panel-offer-warnings" aria-selected="false" data-module="offer-warnings" tabindex="-1">
                @NavIcon("offer-warnings")
                <span class="nav-text">Seller Offer Warnings</span>
            </button>

            <button type="button" class="nav-item" role="tab" id="tab-vat-warnings"
                    aria-controls="panel-vat-warnings" aria-selected="false" data-module="vat-warnings" tabindex="-1">
                @NavIcon("vat-warnings")
                <span class="nav-text">Seller VAT Warnings</span>
            </button>

            <div class="nav-label">Reference</div>

            <button type="button" class="nav-item" role="tab" id="tab-methodology"
                    aria-controls="panel-methodology" aria-selected="false" data-module="methodology" tabindex="-1">
                @NavIcon("methodology")
                <span class="nav-text">Data &amp; Methodology</span>
            </button>
        </nav>

        @* No sign-in exists, so this names the console rather than inventing a person. *@
        <div class="rail-foot">
            <span class="avatar" aria-hidden="true">MO</span>
            <div class="rail-user">
                <div class="rail-user-name">Mirakl Ops</div>
                <div class="rail-user-role">Marketplace Reporting</div>
            </div>
        </div>
      </div>
    </aside>

    <main class="main">

        @* Names whatever panel is open — app.js copies the selected tab's label in here. *@
        <header class="topbar">
            <button type="button" class="icon-btn rail-toggle" id="rail-toggle"
                    aria-controls="rail" aria-expanded="true"
                    aria-label="Toggle navigation" title="Toggle navigation">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" aria-hidden="true">
                    <path d="M3 6h18M3 12h18M3 18h18" />
                </svg>
            </button>

            <h1 class="topbar-title" id="topbar-title">Order Report</h1>

            <div class="topbar-right">
                <span class="topbar-chip">v1.0</span>
                <button type="button" class="theme-toggle" id="theme-toggle"
                        aria-label="Toggle dark mode" title="Toggle dark mode">
                    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                    </svg>
                    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                    </svg>
                </button>
            </div>
        </header>

        <div class="main-inner">

        @* ================= ORDER REPORT ================= *@
        <section class="panel" id="panel-order" role="tabpanel" aria-labelledby="tab-order">

            <header class="page-head">
                @PageIcon("order-report")
                <h1>Late Shipment &amp; Cancellation Report</h1>
                <span class="stamp" id="order-stamp"></span>
            </header>

            <div class="card">
                <div class="uploader">
                    <div class="uploader-grid">
                        <label class="drop" id="order-drop">
                            <span class="drop-title">Orders export</span>
                            <span class="drop-hint">.xlsx or .csv from Mirakl</span>
                            <span class="drop-file">
                                <span class="name"></span><span class="size"></span>
                            </span>
                            <input type="file" id="order-file" accept=".xlsx,.xls"
                                   aria-label="Orders export file (.xlsx)" />
                        </label>
                    </div>

                    <div class="actions">
                        <button type="button" class="btn btn-primary" id="order-generate">
                            <span class="spinner" aria-hidden="true"></span>
                            <span class="btn-text">Generate dashboard</span>
                        </button>
                        <button type="button" class="btn btn-ghost" id="order-excel">
                            <span class="spinner" aria-hidden="true"></span>
                            <span class="btn-text">Download Excel</span>
                        </button>
                    </div>

                    <div class="alert" id="order-alert" role="alert">
                        <strong>Error</strong>
                        <span class="msg"></span>
                    </div>
                </div>
            </div>

            @* The scene is decorative and marks itself aria-hidden; the stage line inside it is
               not, and announces progress through its own aria-live. *@
            <div class="skeleton" id="order-skeleton">
                <partial name="_TowerLoader" model="TowerLoader.Report()" />
            </div>

            <div class="results" id="order-results" hidden>

                <div class="filter-bar">
                    <div class="field">
                        <label for="order-date-from">From (date created)</label>
                        <input type="date" id="order-date-from" />
                    </div>
                    <div class="field">
                        <label for="order-date-to">To (date created)</label>
                        <input type="date" id="order-date-to" />
                    </div>
                    <div class="field">
                        <label for="order-seller">Seller</label>
                        @* Type-ahead rather than a <select>: an export carries hundreds of sellers,
                           and a partial name still narrows the dashboard. *@
                        <input type="search" id="order-seller" list="order-seller-list"
                               placeholder="All sellers" autocomplete="off" />
                        <datalist id="order-seller-list"></datalist>
                    </div>
                    <button type="button" class="btn btn-primary" id="order-apply">Apply filter</button>
                    <button type="button" class="btn btn-ghost" id="order-reset">Reset</button>
                    <span class="filter-summary" id="order-filter-summary"></span>

                    @* Built from the sections themselves once the report renders, so it can never
                       list a section that is not there. *@
                    <nav class="section-nav" id="order-section-nav" aria-label="Report sections"></nav>
                </div>

                <p class="note" id="order-missing-columns" hidden></p>

                @* The headline figures. Everything under them is the explanation. *@
                <div class="hero" id="order-hero"></div>

                @* Names the period every change badge above and below is measured against — a
                   comparison with an unnamed baseline is a number nobody can check. *@
                <p class="note" id="order-baseline-note" hidden></p>

                <div class="section-title" id="sec-overview" data-section="Overview">
                    Key metrics
                    <partial name="_ExportButton" model='new ExportButton("order-kpis", "Key metrics")' />
                </div>
                <div class="kpi-grid" id="order-kpis"></div>
                </p>

                <div class="section-title" id="sec-volume" data-section="Volume &amp; mix">Volume &amp; status mix</div>
                <div class="grid-lead">
                    <div class="card">
                        <partial name="_ExportButton" model='new ExportButton("trendChart", "Orders per day")' />
                        <h3>Order lines per day</h3>
                        <p class="sub">Grouped by date created</p>
                        <div class="chart-box"><canvas id="trendChart"></canvas></div>
                    </div>
                    <div class="card">
                        <partial name="_ExportButton" model='new ExportButton("statusChart", "Status distribution")' />
                        <h3>Status mix</h3>
                        <p class="sub">Share of order lines by Mirakl status</p>
                        <div class="chart-box is-donut"><canvas id="statusChart"></canvas></div>
                        <div class="chart-legend" id="statusChart-legend"></div>
                    </div>
                </div>

                <div class="section-title" id="sec-sellers" data-section="Sellers">Seller performance vs. shipping deadline</div>
                <div class="grid-2x2">
                    <div class="card accent-green">
                        <partial name="_ExportButton" model='new ExportButton("best-sellers-list", "Best on-time sellers")' />
                        <h3>Best on-time sellers</h3>
                        <p class="sub">Highest on-time shipment rate (minimum sample size applied)</p>
                        <ul class="perf-list" id="best-sellers-list"></ul>
                    </div>
                    <div class="card accent-red">
                        <partial name="_ExportButton" model='new ExportButton("worst-sellers-list", "Sellers needing attention")' />
                        <h3>Sellers needing attention</h3>
                        <p class="sub">Lowest on-time shipment rate (minimum sample size applied)</p>
                        <ul class="perf-list" id="worst-sellers-list"></ul>
                    </div>
                    <div class="card">
                        <partial name="_ExportButton" model='new ExportButton("lateChart", "Late shipment top 5")' />
                        <h3>Late shipment &mdash; top 5</h3>
                        <p class="sub">Most late-shipped lines &mdash; the percentage is that seller&rsquo;s own late rate</p>
                        <div class="chart-box"><canvas id="lateChart"></canvas></div>
                    </div>
                    <div class="card">
                        <partial name="_ExportButton" model='new ExportButton("cancelChart", "Cancellations top 5")' />
                        <h3>Cancellations &mdash; top 5</h3>
                        <p class="sub">Most canceled lines &mdash; the percentage is that seller&rsquo;s own cancellation rate</p>
                        <div class="chart-box"><canvas id="cancelChart"></canvas></div>
                    </div>
                </div>

                <div class="section-title" id="sec-carriers" data-section="Carriers">Carrier performance</div>
                <div class="card">
                    <partial name="_ExportButton" model='new ExportButton("carrierChart", "Hours to receive by carrier")' />
                    <h3>Avg. hours to receive by carrier</h3>
                    <p class="sub">Top 8 carriers by volume &mdash; amber marks the ones ticked by hand</p>
                    <div class="chart-box"><canvas id="carrierChart"></canvas></div>
                </div>
                <div class="card">
                    <partial name="_ExportButton" model='new ExportButton("carrier-volume-wrap", "Order lines by carrier")' />
                    <h3>Order lines by carrier</h3>
                    <p class="sub">Volume by shipping company, busiest first &mdash; hover a name for the spellings folded into it</p>
                    <div class="table-scroll" id="carrier-volume-wrap"></div>
                    <p class="table-note" id="carrier-volume-note" hidden></p>
                </div>

                @* ---------- extended analysis ---------- *@

                @* ---------------------------------------------------------------------------
                   Delivery quality — temporarily switched off for a presentation, not retired.
                   To bring it back, remove this comment wrapper AND uncomment the matching
                   renderDeliveryQuality(...) call in wwwroot/js/order-report.js. Both are needed:
                   the markup alone leaves the call writing into an element that is not there, and
                   the call alone renders nothing.

                <div class="section-title" id="sec-delivery" data-section="Delivery quality">
                    Delivery quality
                    <partial name="_ExportButton" model='new ExportButton("delivery-kpis", "Delivery quality")' />
                </div>
                <div class="kpi-grid" id="delivery-kpis"></div>
                </p>
                --------------------------------------------------------------------------- *@

                <div class="section-title" id="sec-cancellations" data-section="Cancellations">Cancellation, rejection &amp; refund breakdown</div>
                <div class="card">
                    <partial name="_ExportButton" model='new ExportButton("cancel-class-wrap", "Outcome breakdown")' />
                    <h3>Outcome breakdown</h3>
                    <p class="sub">Status alone cannot separate these three outcomes</p>
                    <div class="table-scroll" id="cancel-class-wrap"></div>
                </div>

                <div class="grid-2">
                    <div class="card">
                        <partial name="_ExportButton" model='new ExportButton("cancelClassChart", "Outcome mix")' />
                        <h3>Outcome mix</h3>
                        <p class="sub">Share of order lines by how they ended</p>
                        <div class="chart-box is-donut"><canvas id="cancelClassChart"></canvas></div>
                        <div class="chart-legend" id="cancelClassChart-legend"></div>
                    </div>
                    <div class="card">
                        <partial name="_ExportButton" model='new ExportButton("cancel-reason-wrap", "Customer cancellation reasons")' />
                        <h3>Customer cancellation reasons</h3>
                        <p class="sub">Reason codes taken from the cancellation request payload</p>
                        <div class="table-scroll" id="cancel-reason-wrap"></div>
                    </div>
                </div>

                <div class="card accent-red">
                    <partial name="_ExportButton" model='new ExportButton("cancel-detail-wrap", "Lines that did not complete cleanly")' />
                    <h3>Every line that did not complete cleanly</h3>
                    <p class="sub">Ranked by the value lost on the line, worst first &mdash; up to 200 rows</p>
                    <div class="table-scroll" id="cancel-detail-wrap"></div>
                </div>

                <div class="section-title" id="sec-lead-time" data-section="Lead time">Lead time (SLA) analysis</div>
                <div class="card accent-green">
                    <partial name="_ExportButton" model='new ExportButton("lt-opportunity-wrap", "Sellers who could promise less")' />
                    <h3>Sellers who could promise a shorter lead time</h3>
                    <p class="sub">Sellers shipping at least a full day earlier than they promised</p>
                    <div class="table-scroll" id="lt-opportunity-wrap"></div>
                </div>
                </p>

                <div class="section-title" id="sec-categories" data-section="Categories">Category performance</div>
                <div class="grid-2">
                    <div class="card">
                        <partial name="_ExportButton" model='new ExportButton("categoryRevenueChart", "Top categories by revenue")' />
                        <h3>Top categories by revenue</h3>
                        <p class="sub">Highest revenue categories in the selected range</p>
                        <div class="chart-box"><canvas id="categoryRevenueChart"></canvas></div>
                    </div>
                    <div class="card">
                        <partial name="_ExportButton" model='new ExportButton("categoryCancelChart", "Cancellation rate by category")' />
                        <h3>Highest cancellation rate by category</h3>
                        <p class="sub">Percent of lines canceled &mdash; categories with enough volume to rank</p>
                        <div class="chart-box"><canvas id="categoryCancelChart"></canvas></div>
                    </div>
                </div>

                <div class="section-title" id="sec-data-quality" data-section="Data quality">Data quality &amp; exceptions</div>
                <div class="card accent-amber">
                    <partial name="_ExportButton" model='new ExportButton("dq-wrap", "Exception checks")' />
                    <h3>Exception checks</h3>
                    <p class="sub">Records that affect either the reliability of this report or day-to-day operations</p>
                    <div class="table-scroll" id="dq-wrap"></div>
                </div>

                <footer class="page-foot">Marketplace Reporting &middot; Order Report</footer>
            </div>
        </section>

        @* ================= RETURN SLA REPORT ================= *@
        <section class="panel" id="panel-return" role="tabpanel" aria-labelledby="tab-return" hidden>

            <header class="page-head">
                @PageIcon("return-sla")
                <h1>Return SLA Report</h1>
                <span class="stamp" id="return-stamp"></span>
            </header>

            <div class="card">
                <div class="uploader">
                    <div class="uploader-grid">
                        <label class="drop" id="return-orders-drop">
                            <span class="drop-step">Input 1</span>
                            <span class="drop-title">Orders export</span>
                            <span class="drop-hint">.xlsx or .csv from Mirakl</span>
                            <span class="drop-file"><span class="name"></span><span class="size"></span></span>
                            <input type="file" id="return-orders-file" accept=".xlsx,.xls,.csv"
                                   aria-label="Orders export file" />
                        </label>

                        <label class="drop" id="return-templateA-drop">
                            <span class="drop-step">Input 2</span>
                            <span class="drop-title">Return template A</span>
                            <span class="drop-hint">Marketplace Iade &amp; Degisim Talepleri &mdash; optional, at least one of A/B</span>
                            <span class="drop-file"><span class="name"></span><span class="size"></span></span>
                            <input type="file" id="return-templateA-file" accept=".xlsx,.xls,.csv"
                                   aria-label="Return template A file" />
                        </label>

                        <label class="drop" id="return-templateB-drop">
                            <span class="drop-step">Input 3</span>
                            <span class="drop-title">Return template B</span>
                            <span class="drop-hint">NNNNNN-MP.csv &mdash; optional, at least one of A/B</span>
                            <span class="drop-file"><span class="name"></span><span class="size"></span></span>
                            <input type="file" id="return-templateB-file" accept=".xlsx,.xls,.csv"
                                   aria-label="Return template B file" />
                        </label>
                    </div>

                    <div class="actions">
                        <button type="button" class="btn btn-primary" id="return-generate">
                            <span class="spinner" aria-hidden="true"></span>
                            <span class="btn-text">Generate dashboard</span>
                        </button>
                    </div>

                    <div class="alert" id="return-alert" role="alert">
                        <strong>Error</strong>
                        <span class="msg"></span>
                    </div>
                </div>
            </div>

            <div class="skeleton" id="return-skeleton">
                <partial name="_TowerLoader" model="TowerLoader.Report()" />
            </div>

            <div class="results" id="return-results" hidden>

                <div class="filter-bar">
                    <div class="field">
                        <label for="return-date-from">Shipped &mdash; from</label>
                        <input type="date" id="return-date-from" />
                    </div>
                    <div class="field">
                        <label for="return-date-to">Shipped &mdash; to</label>
                        <input type="date" id="return-date-to" />
                    </div>
                    <button type="button" class="btn btn-primary" id="return-apply">Apply filter</button>
                    <button type="button" class="btn btn-ghost" id="return-reset">Reset</button>
                    <span class="filter-summary" id="return-filter-summary"></span>

                    <nav class="section-nav" id="return-section-nav" aria-label="Report sections"></nav>
                </div>

                <div class="section-title" id="return-sec-overview" data-section="Overview">
                    Overview
                    <partial name="_ExportButton" model='new ExportButton("return-kpis", "Overview")' />
                </div>
                <div class="kpi-grid" id="return-kpis"></div>
                <p class="table-note" id="return-consistency"></p>
                @* What each bucket on the line above means — written by the dashboard, because the
                   day counts in it come from the server rather than from this markup. *@
                <p class="note" id="return-consistency-note"></p>
                </p>

                <div class="section-title" id="return-sec-breach" data-section="SLA breach">SLA breached &mdash; past 20 days, return not completed</div>
                <div class="card accent-red">
