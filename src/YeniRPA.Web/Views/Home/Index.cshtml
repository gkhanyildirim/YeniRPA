        @* ================= INCIDENTS REPORT ================= *@
        @*
            Two uploads because the Mirakl incident panel cannot export open and closed incidents
            together. Either one on its own produces a report; the sections that need the other file
            drop out rather than printing an empty table.
        *@
        <section class="panel" id="panel-incidents" role="tabpanel" aria-labelledby="tab-incidents" hidden>

            <header class="page-head">
                @PageIcon("incidents")
                <h1>Incidents Report</h1>
                <span class="stamp" id="inc-stamp"></span>
            </header>

            <div class="card">
                <div class="uploader">
                    <div class="uploader-grid">
                        <label class="drop" id="inc-open-drop">
                            <span class="drop-step">Input 1</span>
                            <span class="drop-title">Open incidents</span>
                            <span class="drop-hint">Mirakl incident export, open filter &mdash; optional, at least one of the two</span>
                            <span class="drop-file"><span class="name"></span><span class="size"></span></span>
                            <input type="file" id="inc-open-file" accept=".csv,.xlsx,.xls"
                                   aria-label="Open incidents file" />
                        </label>

                        <label class="drop" id="inc-closed-drop">
                            <span class="drop-step">Input 2</span>
                            <span class="drop-title">Closed incidents</span>
                            <span class="drop-hint">Mirakl incident export, closed filter &mdash; optional, at least one of the two</span>
                            <span class="drop-file"><span class="name"></span><span class="size"></span></span>
                            <input type="file" id="inc-closed-file" accept=".csv,.xlsx,.xls"
                                   aria-label="Closed incidents file" />
                        </label>
                    </div>

                    <div class="actions">
                        <button type="button" class="btn btn-primary" id="inc-generate">
                            <span class="spinner" aria-hidden="true"></span>
                            <span class="btn-text">Generate dashboard</span>
                        </button>
                    </div>

                    <div class="alert" id="inc-alert" role="alert">
                        <strong>Error</strong>
