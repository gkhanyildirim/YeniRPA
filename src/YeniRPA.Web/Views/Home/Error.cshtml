@{
    ViewData["Title"] = "Error";
}

<div class="shell">
    <main class="main" style="padding-top:64px">
        <div class="empty-state" style="max-width:520px;margin:0 auto">
            <strong style="display:block;font-size:1.05rem;margin-bottom:6px">Something went wrong</strong>
            The request could not be completed. Try again, and check the server log if it keeps failing.
            <div style="margin-top:18px"><a class="btn btn-primary" href="/">Back to reports</a></div>
        </div>
    </main>
</div>
